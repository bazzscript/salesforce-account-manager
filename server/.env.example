# ─────────────────────────────────────────────────────────────────
# Salesforce OAuth 2.0 — Client Credentials Flow
# ─────────────────────────────────────────────────────────────────
# Classic Connected App: https://login.salesforce.com
#                        (sandbox: https://test.salesforce.com)
# External Client App:   the org's My Domain host, e.g.
#                        https://mycompany-dev-ed.develop.my.salesforce.com
#
# Client-credentials tokens are only issued by the My Domain host. With an
# External Client App, login.salesforce.com returns HTTP 400
# "invalid_grant: request not supported on this domain".
# The Setup UI runs on *.my.salesforce-setup.com — that is not the API host.
SF_LOGIN_URL=https://login.salesforce.com

# From the External Client App / Connected App (Setup → App Manager).
# These two values are server-side secrets. Never prefix them with VITE_.
SF_CLIENT_ID=your_consumer_key_here
SF_CLIENT_SECRET=your_consumer_secret_here

# Salesforce REST API version, e.g. 62.0 for Spring '25. Use a version
# your org supports (Setup → Company Information → API version hints).
SF_API_VERSION=62.0

# ─────────────────────────────────────────────────────────────────
# Node.js server
# ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Browser origin allowed by CORS. In dev the Vite proxy makes requests
# same-origin, so this only matters if you call the API directly.
CLIENT_ORIGIN=http://localhost:5173

# Set to true to serve the built Vue app (client/dist) from Express.
# Used by the Docker image; not needed during local development.
SERVE_CLIENT=false

# Demo mode: use an in-memory fake instead of a real org, so you can
# explore the UI before configuring Salesforce. NEVER enable in prod.
SF_MOCK=false
